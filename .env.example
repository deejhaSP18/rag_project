# Copy to .env and edit:  cp .env.example .env

# First admin account, created on first start (only when no account exists yet).
# Use a real password; leave both empty to skip and create one later with:
#   docker compose exec app python -m src.cli create-admin <username>
RAG_ADMIN_USER=admin
RAG_ADMIN_PASSWORD=

# Models (they must exist in Ollama; the full compose file pulls them for you).
RAG_LLM_MODEL=phi4-mini:latest
RAG_EMBED_MODEL=nomic-embed-text

# Port the web app is published on.
RAG_PORT=8000
